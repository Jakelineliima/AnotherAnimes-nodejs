<div class="container_cadastro">
  <form class="form_cadastro" action="" method="POST">

    <legend>Criar conta</legend>
    <br>
    <hr>

    <br>
      <label for="nome">Digite seu nome:</label><br>
      <input type="text" name="nome" placeholder="Nome:" required>
      <br><br>
      <label for="email">Digite um email:</label><br>
      <input type="email" name="email" placeholder="Email" required>
      <br><br>  
      <label for="senha">Digite uma senha:</label><br>
      <input type="password" name="senha" placeholder="Senha" required>
      <br><br>
     

    <div class="btn_cadastrar_user_div">
      <button class="btn btn_login btn_cadastro_user" type="submit">Cadastrar</button>
    </div>

  </form>
</div>